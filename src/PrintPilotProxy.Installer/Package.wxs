<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="PrintPilotProxy"
           Manufacturer="PrintPilotProxy"
           Version="1.0.2.0"
           UpgradeCode="A47F96B2-2C4B-4E7B-98A1-1234567890AB"
           Scope="perMachine"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of PrintPilotProxy is already installed." Schedule="afterInstallInitialize" />

    <util:CloseApplication Id="CloseApp" Target="PrintPilotProxy.App.exe" CloseMessage="yes" RebootPrompt="no" TerminateProcess="1" />

    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Icon Id="AppIcon" SourceFile="..\PrintPilotProxy.App\Resources\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- PROXY-018: the service creates its Windows Firewall rules at runtime, so an uninstall must remove them too.
         Runs only on a real uninstall (not on a major upgrade); a missing rule is not an error. -->
    <CustomAction Id="RemoveProxyFirewallRule"
                  Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;PrintPilotProxy&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveProxyDiscoveryFirewallRule"
                  Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;PrintPilotProxy Discovery (UDP-In)&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveProxyFirewallRule" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveProxyDiscoveryFirewallRule" After="RemoveProxyFirewallRule" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="PrintPilotProxy" Level="1">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="CliComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <ComponentGroupRef Id="DataDirectoryComponents" />
    </Feature>
  </Package>
</Wix>
