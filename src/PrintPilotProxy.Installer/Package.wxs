<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="PrintPilotProxy"
           Manufacturer="PrintPilotProxy"
           Version="0.2.0.0"
           UpgradeCode="A47F96B2-2C4B-4E7B-98A1-1234567890AB"
           Scope="perMachine"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of PrintPilotProxy is already installed." Schedule="afterInstallInitialize" />

    <CustomAction Id="KillApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[SystemFolder]taskkill.exe&quot; /F /IM PrintPilotProxy.App.exe /T" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="KillApp" Before="InstallValidate" Condition="Installed" />
    </InstallExecuteSequence>

    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Feature Id="MainFeature" Title="PrintPilotProxy" Level="1">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="CliComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <ComponentGroupRef Id="DataDirectoryComponents" />
    </Feature>
  </Package>
</Wix>
