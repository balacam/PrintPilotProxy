<UserControl x:Class="PrintPilotProxy.App.Views.NetworkSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PrintPilotProxy.App;component/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Page heading -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="CONFIGURATION" Style="{StaticResource PageEyebrowTextBlockStyle}" />
            <TextBlock Text="{loc:Loc Key=Page.NetworkSettings}"
                       Style="{StaticResource HeaderTextBlockStyle}"
                       Margin="0" />
        </StackPanel>

        <!-- Listener mode -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Margin="0,0,12,0" Background="{StaticResource AccentSoftBrush}" CornerRadius="10">
                        <TextBlock Text="&#xE839;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource AccentHoverBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Key=Net.ListenerMode}"
                                   Style="{StaticResource SubheaderTextBlockStyle}"
                                   Margin="0" />
                        <TextBlock Text="{loc:Loc Key=Net.ChooseInterface}"
                                   Style="{StaticResource MutedTextBlockStyle}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource InsetPanelStyle}" Margin="0,0,0,10">
                    <RadioButton Content="{loc:Loc Key=Net.ModeAuto}"
                                 GroupName="ListenerModeGroup"
                                 IsChecked="{Binding ModeAuto}" />
                </Border>

                <Border Style="{StaticResource InsetPanelStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <RadioButton Content="{loc:Loc Key=Net.ModeAdapter}"
                                     GroupName="ListenerModeGroup"
                                     IsChecked="{Binding ModeSpecificAdapter}" />
                        <ComboBox ItemsSource="{Binding DetectedAdapters}"
                                  SelectedItem="{Binding SelectedAdapter}"
                                  IsEnabled="{Binding IsAdapterSelectionEnabled}"
                                  Margin="27,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InsetPanelStyle}">
                    <StackPanel>
                        <RadioButton Content="{loc:Loc Key=Net.ModeSpecificIp}"
                                     GroupName="ListenerModeGroup"
                                     IsChecked="{Binding ModeSpecificIp}" />
                        <TextBox Text="{Binding SpecificIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsSpecificIpEnabled}"
                                 Margin="27,12,0,0"
                                 Tag="e.g. 192.168.1.100"
                                 Style="{StaticResource PlaceholderTextBoxStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Port and connection limits -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Margin="0,0,12,0" Background="{StaticResource InfoSurfaceBrush}" CornerRadius="10">
                        <TextBlock Text="&#xE9F9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{loc:Loc Key=Net.PortAndLimits}"
                               Style="{StaticResource SubheaderTextBlockStyle}"
                               Margin="0"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Net.ProxyPort}" Style="{StaticResource FieldLabelTextBlockStyle}" />
                            <TextBox Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc Key=Net.DefaultPort}" Style="{StaticResource HelperTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Net.MaxConnections}" Style="{StaticResource FieldLabelTextBlockStyle}" />
                            <TextBox Text="{Binding MaxConnections, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc Key=Net.DefaultConnections}" Style="{StaticResource HelperTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Net.TimeoutSeconds}" Style="{StaticResource FieldLabelTextBlockStyle}" />
                            <TextBox Text="{Binding ConnectionTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc Key=Net.DefaultTimeout}" Style="{StaticResource HelperTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Access and destination security -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Margin="0,0,12,0" Background="{StaticResource SuccessSurfaceBrush}" CornerRadius="10">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Key=Net.SecurityAndAccess}"
                                   Style="{StaticResource SubheaderTextBlockStyle}"
                                   Margin="0" />
                        <TextBlock Text="{loc:Loc Key=Net.SecurityAndAccessDesc}"
                                   Style="{StaticResource MutedTextBlockStyle}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Net.AccessMode}" Style="{StaticResource FieldLabelTextBlockStyle}" Margin="0,0,0,12" />
                            <RadioButton Content="{loc:Loc Key=Net.ClientAccessAllowAll}"
                                         GroupName="ClientAccessGroup"
                                         IsChecked="{Binding ClientAccessAllowAll}"
                                         Margin="0,0,0,12" />
                            <RadioButton Content="{loc:Loc Key=Net.ClientAccessAllowList}"
                                         GroupName="ClientAccessGroup"
                                         IsChecked="{Binding ClientAccessAllowList}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Net.DestinationPortRestrictions}" Style="{StaticResource FieldLabelTextBlockStyle}" Margin="0,0,0,12" />
                            <CheckBox Content="{loc:Loc Key=Net.AllowAllDestinationPorts}"
                                      IsChecked="{Binding AllowAllDestinationPorts}"
                                      Margin="0,0,0,13" />
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllowAllDestinationPorts}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{loc:Loc Key=Net.AllowedPortsWithHint}" Style="{StaticResource FieldLabelTextBlockStyle}" />
                                <TextBox Text="{Binding AllowedDestinationPortsText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Contextual result message -->
        <Border Margin="0,0,0,16"
                Padding="13,10"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="#2B6E5D" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErrorSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="#6F3043" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Actions -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Loc Key=Action.Reload}"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,10,0" />
                <Button Content="{loc:Loc Key=Action.Reset}"
                        Command="{Binding ResetCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0" />
                <Button Content="{loc:Loc Key=Action.Apply}"
                        Command="{Binding ApplyCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
