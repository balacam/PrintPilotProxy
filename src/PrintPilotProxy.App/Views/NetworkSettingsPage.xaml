<UserControl x:Class="PrintPilotProxy.App.Views.NetworkSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PrintPilotProxy.App;component/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{loc:Loc Key=Page.NetworkSettings}" Style="{StaticResource HeaderTextBlockStyle}" />

        <!-- Listener Mode -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Net.ListenerMode}" Style="{StaticResource SubheaderTextBlockStyle}" />
                <TextBlock Text="{loc:Loc Key=Net.ChooseInterface}"
                           Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,0,0,12" />

                <RadioButton Content="{loc:Loc Key=Net.ModeAuto}"
                             IsChecked="{Binding ModeAuto}"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />

                <RadioButton Content="{loc:Loc Key=Net.ModeAdapter}"
                             IsChecked="{Binding ModeSpecificAdapter}"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />

                <ComboBox ItemsSource="{Binding DetectedAdapters}"
                          SelectedItem="{Binding SelectedAdapter}"
                          IsEnabled="{Binding IsAdapterSelectionEnabled}"
                          Margin="24,0,0,12"
                          Background="{StaticResource DarkBackgroundBrush}"
                          Foreground="{StaticResource TextBrush}"
                          Height="30" />

                <RadioButton Content="{loc:Loc Key=Net.ModeSpecificIp}"
                             IsChecked="{Binding ModeSpecificIp}"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />

                <TextBox Text="{Binding SpecificIpAddress, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsSpecificIpEnabled}"
                         Margin="24,0,0,0"
                         Background="{StaticResource DarkBackgroundBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource AccentBrush}"
                         Padding="8,6"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Tag="e.g. 192.168.1.100"
                         Style="{StaticResource PlaceholderTextBoxStyle}" />
            </StackPanel>
        </Border>

        <!-- Port & Limits -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="3" Text="{loc:Loc Key=Net.PortAndLimits}"
                           Style="{StaticResource SubheaderTextBlockStyle}" />

                <!-- Proxy Port -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Loc Key=Net.ProxyPort}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource DarkBackgroundBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource AccentBrush}"
                             Padding="8,6" Height="32"
                             VerticalContentAlignment="Center" />
                    <TextBlock Text="{loc:Loc Key=Net.DefaultPort}" Foreground="{StaticResource TextBrush}" Opacity="0.5" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Max Connections -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Loc Key=Net.MaxConnections}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox Text="{Binding MaxConnections, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource DarkBackgroundBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource AccentBrush}"
                             Padding="8,6" Height="32"
                             VerticalContentAlignment="Center" />
                    <TextBlock Text="{loc:Loc Key=Net.DefaultConnections}" Foreground="{StaticResource TextBrush}" Opacity="0.5" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Connection Timeout -->
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="{loc:Loc Key=Net.TimeoutSeconds}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ConnectionTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource DarkBackgroundBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource AccentBrush}"
                             Padding="8,6" Height="32"
                             VerticalContentAlignment="Center" />
                    <TextBlock Text="{loc:Loc Key=Net.DefaultTimeout}" Foreground="{StaticResource TextBrush}" Opacity="0.5" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Client Access Mode & Security -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Güvenlik &amp; Erişim" Style="{StaticResource SubheaderTextBlockStyle}" />
                <TextBlock Text="İstemci erişim kurallarını ve hedef port kısıtlamalarını yapılandırın."
                           Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Client Access -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Erişim Modu:" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <RadioButton Content="Tüm İstemcilere İzin Ver (AllowAll)"
                                     IsChecked="{Binding ClientAccessAllowAll}"
                                     Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                        <RadioButton Content="Sadece İzin Verilenler (AllowList)"
                                     IsChecked="{Binding ClientAccessAllowList}"
                                     Foreground="{StaticResource TextBrush}" />
                    </StackPanel>

                    <!-- Port Restrictions -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hedef Port Kısıtlamaları:" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <CheckBox Content="Tüm hedef portlara izin ver (Önerilmez)"
                                  IsChecked="{Binding AllowAllDestinationPorts}"
                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                        <StackPanel Margin="0,4,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AllowAllDestinationPorts}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="İzin Verilen Portlar (Virgül ile ayırın):" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,0,0,4" FontSize="11" />
                            <TextBox Text="{Binding AllowedDestinationPortsText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource DarkBackgroundBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource AccentBrush}"
                                     Padding="6,4" Height="28"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status message -->
        <TextBlock Text="{Binding StatusMessage}"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal">
            <Button Content="{loc:Loc Key=Action.Apply}"
                    Command="{Binding ApplyCommand}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    Padding="20,8"
                    Margin="0,0,12,0" />
            <Button Content="{loc:Loc Key=Action.Reset}"
                    Command="{Binding ResetCommand}"
                    Padding="20,8"
                    Margin="0,0,12,0" />
            <Button Content="{loc:Loc Key=Action.Reload}"
                    Command="{Binding LoadCommand}"
                    Padding="20,8" />
        </StackPanel>
    </StackPanel>
</UserControl>
