<Window x:Class="PrintPilotProxy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization"
        Title="PrintPilotProxy"
        Icon="/Resources/app.ico"
        Height="840"
        Width="1280"
        MinHeight="700"
        MinWidth="1020"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Product identity -->
                <Grid Grid.Row="0" Margin="20,24,18,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44"
                            Height="44"
                            Margin="0,0,12,0"
                            Background="{StaticResource AccentGradientBrush}"
                            CornerRadius="12">
                        <Grid>
                            <Ellipse Width="26" Height="26" Fill="#18FFFFFF" />
                            <TextBlock Text="&#xE749;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PrintPilotProxy"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="Management console"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Navigation links -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="CONTROL CENTER"
                                   Margin="25,0,0,8"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Dashboard"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Dashboard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE80F;" Style="{StaticResource NavIconTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Key=Nav.Dashboard}" Style="{StaticResource NavLabelTextStyle}" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="NetworkSettings"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=NetworkSettings}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE839;" Style="{StaticResource NavIconTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Key=Nav.NetworkSettings}" Style="{StaticResource NavLabelTextStyle}" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="AllowedClients"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=AllowedClients}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE716;" Style="{StaticResource NavIconTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Key=Nav.AllowedClients}" Style="{StaticResource NavLabelTextStyle}" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Service"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Service}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;" Style="{StaticResource NavIconTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Key=Nav.Service}" Style="{StaticResource NavLabelTextStyle}" />
                            </Grid>
                        </Button>

                        <Separator />

                        <TextBlock Text="OPERATIONS"
                                   Margin="25,2,0,8"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Logs"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Logs}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource NavIconTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Key=Nav.Logs}" Style="{StaticResource NavLabelTextStyle}" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Diagnostics"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Diagnostics}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" Style="{StaticResource NavIconTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Key=Nav.Diagnostics}" Style="{StaticResource NavLabelTextStyle}" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Security"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Security}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72E;" Style="{StaticResource NavIconTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Key=Nav.Security}" Style="{StaticResource NavLabelTextStyle}" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Language"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Language}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE774;" Style="{StaticResource NavIconTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Key=Nav.Language}" Style="{StaticResource NavLabelTextStyle}" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="About"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=About}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;" Style="{StaticResource NavIconTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Key=Nav.About}" Style="{StaticResource NavLabelTextStyle}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Listener summary -->
                <Border Grid.Row="2"
                        Margin="16,10,16,18"
                        Padding="13"
                        Background="#70182237"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                Margin="0,0,10,0"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="8">
                            <TextBlock Text="&#xE968;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=MainWindow.Listen}"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding ListenAddress}"
                                       Margin="0,2,0,0"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       ToolTip="{Binding ListenAddress}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Page canvas -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Ellipse Width="520"
                     Height="520"
                     Margin="0,-280,-240,0"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Fill="#0B7180FF"
                     IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
            </Ellipse>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ContentControl Content="{Binding CurrentPage}"
                                Margin="32,26,32,32"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </ScrollViewer>
        </Grid>

        <!-- Operational status bar -->
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="#F20B1323"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnectedToService}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{loc:Loc Key=MainWindow.Status}"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding ProxyStatus}"
                               Margin="5,0,0,0"
                               FontSize="11"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProxyStatusRaw}" Value="Running">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProxyStatusRaw}" Value="Stopped">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProxyStatusRaw}" Value="Faulted">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Height="16"
                        Background="{StaticResource BorderBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE968;"
                               Margin="0,0,7,0"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding ListenAddress}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="4"
                           Text="PrintPilotProxy"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
