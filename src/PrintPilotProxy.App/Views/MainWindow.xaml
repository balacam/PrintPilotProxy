<Window x:Class="PrintPilotProxy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization"
        Title="PrintPilotProxy" Height="750" Width="1150" MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}">
            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="PrintPilotProxy"
                           Style="{StaticResource HeaderTextBlockStyle}"
                           Margin="18,0,0,24"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="16" />

                <Button Content="🏠  {loc:Loc Key=Nav.Dashboard}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Dashboard"
                        Style="{StaticResource NavButtonStyle}" />

                <Button Content="🌐  {loc:Loc Key=Nav.NetworkSettings}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="NetworkSettings"
                        Style="{StaticResource NavButtonStyle}" />

                <Button Content="👥  {loc:Loc Key=Nav.AllowedClients}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="AllowedClients"
                        Style="{StaticResource NavButtonStyle}" />

                <Button Content="🔥  {loc:Loc Key=Nav.Firewall}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Firewall"
                        Style="{StaticResource NavButtonStyle}" />

                <Button Content="⚙️  {loc:Loc Key=Nav.Service}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Service"
                        Style="{StaticResource NavButtonStyle}" />

                <Button Content="📋  {loc:Loc Key=Nav.Logs}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Logs"
                        Style="{StaticResource NavButtonStyle}" />

                <Button Content="🔍  {loc:Loc Key=Nav.Diagnostics}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Diagnostics"
                        Style="{StaticResource NavButtonStyle}" />

                <Button Content="🛡️  {loc:Loc Key=Nav.Security}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Security"
                        Style="{StaticResource NavButtonStyle}" />

                <Button Content="🌍  {loc:Loc Key=Nav.Language}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Language"
                        Style="{StaticResource NavButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Column="1" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding CurrentPage}" Margin="24,20,24,20" />
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="#3A3A50">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                    <Ellipse.Fill>
                        <Binding Path="IsConnectedToService">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{loc:Loc Key=MainWindow.Status}" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding ProxyStatus}"
                           FontWeight="SemiBold"
                           Margin="0,0,16,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProxyStatus}" Value="RUNNING">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProxyStatus}" Value="STOPPED">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProxyStatus}" Value="FAULTED">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{loc:Loc Key=MainWindow.Listen}" Foreground="{StaticResource TextBrush}" Opacity="0.7" />
                <TextBlock Text="{Binding ListenAddress}" Foreground="{StaticResource TextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
