<Window x:Class="PrintPilotProxy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintPilotProxy" Height="750" Width="1100" MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="PrintPilotProxy" Style="{StaticResource HeaderTextBlockStyle}" 
                           Margin="20,0,0,20" Foreground="{StaticResource AccentBrush}" />
                <Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavButtonStyle}" />
                <Button Content="Proxy Settings" Command="{Binding NavigateCommand}" CommandParameter="ProxySettings" Style="{StaticResource NavButtonStyle}" />
                <Button Content="Allowed Clients" Command="{Binding NavigateCommand}" CommandParameter="AllowedClients" Style="{StaticResource NavButtonStyle}" />
                <Button Content="Security" Command="{Binding NavigateCommand}" CommandParameter="Security" Style="{StaticResource NavButtonStyle}" />
                <Button Content="Firewall" Command="{Binding NavigateCommand}" CommandParameter="Firewall" Style="{StaticResource NavButtonStyle}" />
                <Button Content="Service" Command="{Binding NavigateCommand}" CommandParameter="Service" Style="{StaticResource NavButtonStyle}" />
                <Button Content="Logs" Command="{Binding NavigateCommand}" CommandParameter="Logs" Style="{StaticResource NavButtonStyle}" />
                <Button Content="Diagnostics" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" Style="{StaticResource NavButtonStyle}" />
                <Button Content="Advanced" Command="{Binding NavigateCommand}" CommandParameter="Advanced" Style="{StaticResource NavButtonStyle}" />
                <Button Content="About" Command="{Binding NavigateCommand}" CommandParameter="About" Style="{StaticResource NavButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1" Grid.Row="0" Content="{Binding CurrentPage}" Margin="20" />

        <!-- Status Bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource PanelBackgroundBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="Status: " Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding ProxyStatus}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" />
                <TextBlock Text=" | Listen Address: " Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" />
                <TextBlock Text="{Binding ListenAddress}" Foreground="{StaticResource TextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
