<Window x:Class="PrintPilotProxy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization"
        Title="PrintPilotProxy" Height="820" Width="1240" MinHeight="700" MinWidth="1020"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sidebar Header / Branding -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,18,16,20">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource DarkBackgroundBrush}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PrintPilotProxy" FontWeight="Bold" FontSize="15" Foreground="White"/>
                        <TextBlock Text="Console" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Links -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,12">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Dashboard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Key=Nav.Dashboard}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="NetworkSettings" Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=NetworkSettings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Key=Nav.NetworkSettings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="AllowedClients" Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=AllowedClients}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Key=Nav.AllowedClients}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Service" Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Service}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Key=Nav.Service}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Logs" Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Logs}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Key=Nav.Logs}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Diagnostics}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Key=Nav.Diagnostics}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Security" Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Security}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Key=Nav.Security}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Language" Style="{StaticResource NavButtonStyle}"
                                Tag="{Binding CurrentPageName, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Language}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Key=Nav.Language}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Column="1" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding CurrentPage}" Margin="24,14,24,14" />
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="#3A3A50">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                    <Ellipse.Fill>
                        <Binding Path="IsConnectedToService">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{loc:Loc Key=MainWindow.Status}" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding ProxyStatus}"
                           FontWeight="SemiBold"
                           Margin="0,0,16,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProxyStatus}" Value="Running">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProxyStatus}" Value="Stopped">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProxyStatus}" Value="Faulted">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{loc:Loc Key=MainWindow.Listen}" Foreground="{StaticResource TextBrush}" Opacity="0.7" />
                <TextBlock Text="{Binding ListenAddress}" Foreground="{StaticResource TextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
