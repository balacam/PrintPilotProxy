<UserControl x:Class="PrintPilotProxy.App.Views.AllowedClientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <StackPanel>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="ACCESS CONTROL" Style="{StaticResource PageEyebrowTextBlockStyle}" />
            <TextBlock Text="{loc:Loc Key=Page.AllowedClients}" Style="{StaticResource HeaderTextBlockStyle}" Margin="0" />
        </StackPanel>

        <!-- Access mode -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Margin="0,0,12,0" Background="{StaticResource AccentSoftBrush}" CornerRadius="10">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{loc:Loc Key=Cli.ClientAccessMode}" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0" VerticalAlignment="Center" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <RadioButton Content="{loc:Loc Key=Cli.AllowAllWithHint}"
                                         IsChecked="{Binding ModeAllowAll}" />
                            <TextBlock Text="{loc:Loc Key=Cli.AllowAllHint}"
                                       Margin="27,9,0,0"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ModeAllowAll, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource InsetPanelStyle}">
                        <RadioButton Content="{loc:Loc Key=Cli.AllowListWithHint}"
                                     IsChecked="{Binding ModeAllowList}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Add client -->
        <Border Style="{StaticResource CardStyle}"
                Visibility="{Binding ModeAllowList, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Cli.AddClient}" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0,0,0,16" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Key=Cli.Name}" Style="{StaticResource FieldLabelTextBlockStyle}" />
                        <TextBox Text="{Binding NewClientName, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. PrintPilot-PC-01"
                                 Style="{StaticResource PlaceholderTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc Key=Cli.IpOrCidr}" Style="{StaticResource FieldLabelTextBlockStyle}" />
                        <TextBox Text="{Binding NewClientIpOrCidr, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="192.168.1.0/24 or 10.0.0.5"
                                 Style="{StaticResource PlaceholderTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{loc:Loc Key=Cli.DescriptionOptional}" Style="{StaticResource FieldLabelTextBlockStyle}" />
                        <TextBox Text="{Binding NewClientDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. Accounting workstation"
                                 Style="{StaticResource PlaceholderTextBoxStyle}" />
                    </StackPanel>

                    <Button Grid.Column="6"
                            Content="{loc:Loc Key=Action.Add}"
                            Command="{Binding AddClientCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Client list -->
        <Border Style="{StaticResource CardStyle}"
                Visibility="{Binding ModeAllowList, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Key=Cli.ClientList}" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{loc:Loc Key=Cli.RemoveSelected}"
                            Command="{Binding RemoveClientCommand}"
                            Style="{StaticResource DangerButtonStyle}" />
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource DarkBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding SelectedClient}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              MinHeight="170"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="{loc:Loc Key=Cli.ColEnabled}" Binding="{Binding IsEnabled}" Width="78" />
                            <DataGridTextColumn Header="{loc:Loc Key=Cli.ColName}" Binding="{Binding Name}" Width="170" />
                            <DataGridTextColumn Header="{loc:Loc Key=Cli.ColIpOrCidr}" Binding="{Binding IpOrCidr}" Width="180" />
                            <DataGridTextColumn Header="{loc:Loc Key=Cli.ColDescription}" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <!-- Result message -->
        <Border Margin="0,0,0,16"
                Padding="13,10"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="#2B6E5D" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErrorSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="#6F3043" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Actions -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Loc Key=Action.Reload}"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,10,0" />
                <Button Content="{loc:Loc Key=Action.Apply}"
                        Command="{Binding ApplyCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
