<UserControl x:Class="PrintPilotProxy.App.Views.AllowedClientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <StackPanel>
        <TextBlock Text="{loc:Loc Key=Page.AllowedClients}" Style="{StaticResource HeaderTextBlockStyle}" />

        <!-- Access Mode -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Cli.ClientAccessMode}" Style="{StaticResource SubheaderTextBlockStyle}" />
                <RadioButton Content="{loc:Loc Key=Cli.AllowAllWithHint}"
                             IsChecked="{Binding ModeAllowAll}"
                             Foreground="{StaticResource TextBrush}"
                             Margin="0,0,0,6" />
                <TextBlock Text="{loc:Loc Key=Cli.AllowAllHint}"
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="11"
                           Margin="20,0,0,8"
                           Visibility="{Binding ModeAllowAll, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <RadioButton Content="{loc:Loc Key=Cli.AllowListWithHint}"
                             IsChecked="{Binding ModeAllowList}"
                             Foreground="{StaticResource TextBrush}" />
            </StackPanel>
        </Border>

        <!-- Add Client Form -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                Visibility="{Binding ModeAllowList, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Cli.AddClient}" Style="{StaticResource SubheaderTextBlockStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc Key=Cli.Name}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,0,0,4" FontSize="11"/>
                        <TextBox Text="{Binding NewClientName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource DarkBackgroundBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource AccentBrush}"
                                 Padding="6,5" Height="30" VerticalContentAlignment="Center"
                                 Tag="e.g. PrintPilot-PC-01"
                                 Style="{StaticResource PlaceholderTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc Key=Cli.IpOrCidr}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,0,0,4" FontSize="11"/>
                        <TextBox Text="{Binding NewClientIpOrCidr, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource DarkBackgroundBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource AccentBrush}"
                                 Padding="6,5" Height="30" VerticalContentAlignment="Center"
                                 Tag="192.168.1.0/24  or  10.0.0.5"
                                 Style="{StaticResource PlaceholderTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc Key=Cli.DescriptionOptional}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,0,0,4" FontSize="11"/>
                        <TextBox Text="{Binding NewClientDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource DarkBackgroundBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource AccentBrush}"
                                 Padding="6,5" Height="30" VerticalContentAlignment="Center"
                                 Tag="e.g. Accounting workstation"
                                 Style="{StaticResource PlaceholderTextBoxStyle}" />
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="{loc:Loc Key=Action.Add}"
                            Command="{Binding AddClientCommand}"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            Padding="14,0"
                            Height="30"
                            VerticalAlignment="Bottom" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Client List -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                Visibility="{Binding ModeAllowList, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{loc:Loc Key=Cli.ClientList}" Style="{StaticResource SubheaderTextBlockStyle}" DockPanel.Dock="Left" Margin="0"/>
                    <Button Content="{loc:Loc Key=Cli.RemoveSelected}"
                            Command="{Binding RemoveClientCommand}"
                            DockPanel.Dock="Right"
                            Padding="12,4"
                            Background="#5A2020"
                            Foreground="White" />
                </DockPanel>

                <DataGrid ItemsSource="{Binding Clients}"
                          SelectedItem="{Binding SelectedClient}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          Background="Transparent"
                          Foreground="{StaticResource TextBrush}"
                          RowBackground="{StaticResource PanelBackgroundBrush}"
                          AlternatingRowBackground="{StaticResource DarkBackgroundBrush}"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          MinHeight="100"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn  Header="Enabled"     Binding="{Binding IsEnabled}"    Width="70" />
                        <DataGridTextColumn      Header="Name"        Binding="{Binding Name}"         Width="160" />
                        <DataGridTextColumn      Header="IP / CIDR"   Binding="{Binding IpOrCidr}"     Width="160" />
                        <DataGridTextColumn      Header="Description" Binding="{Binding Description}"  Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Status -->
        <TextBlock Text="{Binding StatusMessage}"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal">
            <Button Content="{loc:Loc Key=Action.Apply}"
                    Command="{Binding ApplyCommand}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    Padding="20,8"
                    Margin="0,0,12,0" />
            <Button Content="{loc:Loc Key=Action.Reload}"
                    Command="{Binding LoadCommand}"
                    Padding="20,8" />
        </StackPanel>
    </StackPanel>
</UserControl>
