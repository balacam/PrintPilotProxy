<UserControl x:Class="PrintPilotProxy.App.Views.ProxySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <!-- ProxySettingsPage is superseded by NetworkSettingsPage.
         This stub prevents navigation errors if old bookmarks are used. -->
    <StackPanel>
        <TextBlock Text="{loc:Loc Key=Page.ProxySettings}" Style="{StaticResource HeaderTextBlockStyle}" />
        <TextBlock Text="{loc:Loc Key=ProxySettings.Moved}" Foreground="{StaticResource WarningBrush}" />
    </StackPanel>
</UserControl>
