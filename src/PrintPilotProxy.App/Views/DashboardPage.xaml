<UserControl x:Class="PrintPilotProxy.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PrintPilotProxy.App;component/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header row -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Loc Key=Page.Dashboard}" Style="{StaticResource HeaderTextBlockStyle}" DockPanel.Dock="Left" Margin="0" />
            <Button Content="{loc:Loc Key=Action.Refresh}"
                    Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Right"
                    Padding="12,6"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White" />
        </DockPanel>

        <!-- Status cards -->
        <UniformGrid Columns="4" Grid.Row="1" Margin="0,0,0,12">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Dash.ProxyState}" Foreground="{StaticResource TextBrush}" Opacity="0.6" FontSize="11"/>
                    <TextBlock Text="{Binding ProxyState}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProxyState}" Value="Running">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProxyState}" Value="Stopped">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProxyState}" Value="Faulted">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Dash.Uptime}" Foreground="{StaticResource TextBrush}" Opacity="0.6" FontSize="11"/>
                    <TextBlock Text="{Binding UptimeString}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Dash.TotalRequests}" Foreground="{StaticResource TextBrush}" Opacity="0.6" FontSize="11"/>
                    <TextBlock Text="{Binding TotalRequests}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Dash.Errors}" Foreground="{StaticResource TextBrush}" Opacity="0.6" FontSize="11"/>
                    <TextBlock Text="{Binding TotalErrors}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource ErrorBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Config summary row -->
        <UniformGrid Columns="4" Grid.Row="2" Margin="0,0,0,16">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Dash.ListeningAddress}" Foreground="{StaticResource TextBrush}" Opacity="0.6" FontSize="11"/>
                    <TextBlock Text="{Binding ListeningAddress}" FontSize="13" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Dash.AccessMode}" Foreground="{StaticResource TextBrush}" Opacity="0.6" FontSize="11"/>
                    <TextBlock Text="{Binding AccessMode}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Dash.AllowedClients}" Foreground="{StaticResource TextBrush}" Opacity="0.6" FontSize="11"/>
                    <TextBlock Text="{Binding AllowedClientsCount}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Dash.AllowedPorts}" Foreground="{StaticResource TextBrush}" Opacity="0.6" FontSize="11"/>
                    <TextBlock Text="{Binding AllowedPorts}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Recent Activity -->
        <Border Style="{StaticResource CardStyle}" Grid.Row="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Loc Key=Dash.RecentActivity}" Style="{StaticResource SubheaderTextBlockStyle}" />
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding RecentActivities}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          Foreground="{StaticResource TextBrush}"
                          RowBackground="{StaticResource PanelBackgroundBrush}"
                          AlternatingRowBackground="{StaticResource DarkBackgroundBrush}"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          MinHeight="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time"        Binding="{Binding Time}"        Width="80" />
                        <DataGridTextColumn Header="Client IP"   Binding="{Binding ClientIp}"    Width="130" />
                        <DataGridTextColumn Header="Method"      Binding="{Binding Method}"      Width="70" />
                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*" />
                        <DataGridTextColumn Header="Status"      Binding="{Binding Status}"      Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
