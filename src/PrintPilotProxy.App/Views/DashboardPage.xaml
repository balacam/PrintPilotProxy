<UserControl x:Class="PrintPilotProxy.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PrintPilotProxy.App;component/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OVERVIEW" Style="{StaticResource PageEyebrowTextBlockStyle}" />
                <TextBlock Text="{loc:Loc Key=Page.Dashboard}"
                           Style="{StaticResource HeaderTextBlockStyle}"
                           Margin="0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{loc:Loc Key=Action.Refresh}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Primary proxy state -->
        <Border Grid.Row="1" Style="{StaticResource HeroCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="1.75*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="54"
                            Height="54"
                            Margin="0,0,15,0"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="#3B4C84"
                            BorderThickness="1"
                            CornerRadius="14">
                        <TextBlock Text="&#xE968;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="{StaticResource AccentHoverBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Key=Dash.ProxyState}"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProxyState}" Value="Running">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProxyState}" Value="Stopped">
                                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProxyState}" Value="Faulted">
                                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ProxyState}"
                                       FontSize="22"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProxyState}" Value="Running">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProxyState}" Value="Stopped">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProxyState}" Value="Faulted">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1"
                        Width="1"
                        Margin="18,0"
                        Background="#34486A"
                        HorizontalAlignment="Center" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="{loc:Loc Key=Dash.ListeningAddress}"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{Binding ListeningAddress}"
                                   Margin="0,5,0,0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding ListeningAddress}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="{loc:Loc Key=Dash.AccessMode}"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{Binding AccessMode}"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="{loc:Loc Key=Dash.AllowedPorts}"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{Binding AllowedPorts}"
                                   Margin="0,5,0,0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding AllowedPorts}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Operational metrics -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Key=Dash.Uptime}" Style="{StaticResource MetricLabelTextBlockStyle}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="30" Height="30" Background="{StaticResource AccentSoftBrush}" CornerRadius="8">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding UptimeString}" Style="{StaticResource MetricValueTextBlockStyle}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Key=Dash.TotalRequests}" Style="{StaticResource MetricLabelTextBlockStyle}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="30" Height="30" Background="{StaticResource InfoSurfaceBrush}" CornerRadius="8">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding TotalRequests}" Style="{StaticResource MetricValueTextBlockStyle}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Key=Dash.AllowedClients}" Style="{StaticResource MetricLabelTextBlockStyle}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="30" Height="30" Background="{StaticResource SuccessSurfaceBrush}" CornerRadius="8">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding AllowedClientsCount}" Style="{StaticResource MetricValueTextBlockStyle}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Key=Dash.Errors}" Style="{StaticResource MetricLabelTextBlockStyle}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="30" Height="30" Background="{StaticResource ErrorSurfaceBrush}" CornerRadius="8">
                            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Text="{Binding TotalErrors}"
                               Style="{StaticResource MetricValueTextBlockStyle}"
                               Foreground="{StaticResource ErrorBrush}"
                               VerticalAlignment="Bottom" />
                </Grid>
            </Border>
        </Grid>

        <!-- Recent activity -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" Margin="0,0,11,0" Background="{StaticResource AccentSoftBrush}" CornerRadius="8">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{loc:Loc Key=Dash.RecentActivity}"
                                   Style="{StaticResource SubheaderTextBlockStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource DarkBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding RecentActivities}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="190">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=Dash.ColTime}" Binding="{Binding Time}" Width="92" />
                            <DataGridTextColumn Header="{loc:Loc Key=Dash.ColClientIp}" Binding="{Binding ClientIp}" Width="140" />
                            <DataGridTextColumn Header="{loc:Loc Key=Dash.ColMethod}" Binding="{Binding Method}" Width="86" />
                            <DataGridTextColumn Header="{loc:Loc Key=Dash.ColDestination}" Binding="{Binding Destination}" Width="2*" />
                            <DataGridTextColumn Header="{loc:Loc Key=Dash.ColStatus}" Binding="{Binding Status}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
