<UserControl x:Class="PrintPilotProxy.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Dashboard" Style="{StaticResource HeaderTextBlockStyle}" Grid.Row="0" />

        <!-- Status Cards -->
        <UniformGrid Columns="4" Grid.Row="1" Margin="0,0,0,20">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Proxy Engine" Foreground="{StaticResource TextBrush}" Opacity="0.7" />
                    <TextBlock Text="{Binding EngineName}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Allowed Clients" Foreground="{StaticResource TextBrush}" Opacity="0.7" />
                    <TextBlock Text="{Binding AllowedClientsCount}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Total Requests" Foreground="{StaticResource TextBrush}" Opacity="0.7" />
                    <TextBlock Text="{Binding TotalRequests}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Uptime" Foreground="{StaticResource TextBrush}" Opacity="0.7" />
                    <TextBlock Text="{Binding UptimeString}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Recent Activity -->
        <Border Style="{StaticResource CardStyle}" Grid.Row="2" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Recent Activity" Style="{StaticResource SubheaderTextBlockStyle}" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding RecentActivities}" AutoGenerateColumns="False" 
                          IsReadOnly="True" Background="Transparent" Foreground="{StaticResource TextBrush}"
                          RowBackground="{StaticResource PanelBackgroundBrush}" AlternatingRowBackground="{StaticResource DarkBackgroundBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="150" />
                        <DataGridTextColumn Header="Client IP" Binding="{Binding ClientIp}" Width="150" />
                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="200" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
