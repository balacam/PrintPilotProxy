<UserControl x:Class="PrintPilotProxy.App.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc Key=Page.Logs}" Style="{StaticResource HeaderTextBlockStyle}" DockPanel.Dock="Left" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Key=Action.Refresh}" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,8,0" Background="{StaticResource AccentBrush}" Foreground="White"/>
                <Button Content="{loc:Loc Key=Logs.OpenFolder}" Command="{Binding OpenLogFolderCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc Key=Logs.Copy}" Command="{Binding CopyToClipboardCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc Key=Logs.ClearView}" Command="{Binding ClearViewCommand}" Padding="12,6"/>
            </StackPanel>
        </DockPanel>

        <!-- Mode Selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="🔗  İstemci Bağlantı Günlükleri" IsChecked="{Binding ShowAccessLogs}" Margin="0,0,16,0" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <RadioButton Content="⚙️  Servis Sistem Logları" IsChecked="{Binding ShowSystemLogs}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Access Logs View -->
        <Border Grid.Row="2" Margin="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowAccessLogs}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DataGrid ItemsSource="{Binding AccessLogs}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      Foreground="{StaticResource TextBrush}"
                      RowBackground="{StaticResource PanelBackgroundBrush}"
                      AlternatingRowBackground="{StaticResource DarkBackgroundBrush}"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      MinHeight="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Zaman"       Binding="{Binding Time}"        Width="100" />
                    <DataGridTextColumn Header="İstemci IP"  Binding="{Binding ClientIp}"    Width="160" />
                    <DataGridTextColumn Header="Metot"       Binding="{Binding Method}"      Width="90" />
                    <DataGridTextColumn Header="Hedef Adres" Binding="{Binding Destination}" Width="*" />
                    <DataGridTextColumn Header="Durum"       Binding="{Binding Status}"      Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- System Logs View -->
        <Border Grid.Row="2" Margin="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowSystemLogs}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding LogContent}"
                          IsReadOnly="True"
                          Background="Transparent"
                          Foreground="#A8FF78"
                          FontFamily="Consolas"
                          FontSize="12"
                          BorderThickness="0"
                          TextWrapping="NoWrap"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          MinHeight="300" />
            </ScrollViewer>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextBrush}" Opacity="0.7" FontSize="11"
                   Margin="0,8,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
    </Grid>
</UserControl>
