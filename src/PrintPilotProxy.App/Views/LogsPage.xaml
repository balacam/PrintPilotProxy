<UserControl x:Class="PrintPilotProxy.App.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc Key=Page.Logs}" Style="{StaticResource HeaderTextBlockStyle}" DockPanel.Dock="Left" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Key=Action.Refresh}" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,8,0" Background="{StaticResource AccentBrush}" Foreground="White"/>
                <Button Content="{loc:Loc Key=Logs.OpenFolder}" Command="{Binding OpenLogFolderCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc Key=Logs.Copy}" Command="{Binding CopyToClipboardCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc Key=Logs.ClearView}" Command="{Binding ClearViewCommand}" Padding="12,6"/>
            </StackPanel>
        </DockPanel>

        <!-- File info -->
        <TextBlock Grid.Row="1"
                   Text="{Binding CurrentLogFile, StringFormat='File: {0}'}"
                   Foreground="{StaticResource TextBrush}" Opacity="0.6" FontSize="11"
                   Margin="0,0,0,8"
                   Visibility="{Binding CurrentLogFile, Converter={StaticResource StringToVisibilityConverter}}" />

        <!-- Log content -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding LogContent}"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="#A8FF78"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderThickness="0"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled"
                         MinHeight="300" />
            </ScrollViewer>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextBrush}" Opacity="0.7" FontSize="11"
                   Margin="0,8,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
    </Grid>
</UserControl>
