<UserControl x:Class="PrintPilotProxy.App.Views.SecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <StackPanel>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="SECURITY POSTURE" Style="{StaticResource PageEyebrowTextBlockStyle}" />
            <TextBlock Text="{loc:Loc Key=Page.Security}" Style="{StaticResource HeaderTextBlockStyle}" Margin="0" />
        </StackPanel>

        <!-- Security summary -->
        <Border Style="{StaticResource HeroCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" Margin="0,0,15,0" Background="{StaticResource AccentSoftBrush}" CornerRadius="14">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=Sec.Title}" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0" />
                    <TextBlock Text="{loc:Loc Key=Sec.Description}" Style="{StaticResource MutedTextBlockStyle}" Margin="0,4,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverallStatusBrushKey}" Value="SuccessBrush">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallStatusBrushKey}" Value="ErrorBrush">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding OverallStatus}" FontSize="15" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverallStatusBrushKey}" Value="SuccessBrush">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallStatusBrushKey}" Value="ErrorBrush">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="22,0,0,0" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Key=Sec.RerunAudit}"
                            Command="{Binding RunAuditCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBlock Text="{loc:Loc Key=Diag.Running}"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="11"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Audit results -->
        <ItemsControl ItemsSource="{Binding Checks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="40" Height="40" Margin="0,0,13,0" CornerRadius="10" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Text" Value="&#xE814;" />
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Passed}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextBlockStyle}" Margin="0,4,0,7" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <Border Margin="0,9,0,0" Padding="10,7" Background="{StaticResource WarningSurfaceBrush}" CornerRadius="6" Visibility="{Binding Remediation, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Remediation}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2" CornerRadius="6" Padding="9,4" Margin="14,0,0,0" VerticalAlignment="Top">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding LevelBrushKey, Converter={StaticResource BrushKeyToColorConverter}, FallbackValue=#555555}" />
                                </Border.Background>
                                <TextBlock Text="{Binding LevelLabel}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
