<UserControl x:Class="PrintPilotProxy.App.Views.ServicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PrintPilotProxy.App;component/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{loc:Loc Key=Page.Service}" Style="{StaticResource HeaderTextBlockStyle}" />

        <!-- Status Card -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="2" Text="{loc:Loc Key=Svc.Header}"
                           Style="{StaticResource SubheaderTextBlockStyle}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=Svc.ServiceStatus}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,5,0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WindowsServiceState}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,5" Foreground="{StaticResource TextBrush}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=Svc.StartupType}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,5,0,5"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StartupType}" Margin="0,5,0,5" Foreground="{StaticResource TextBrush}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Key=Svc.ProxyState}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,5,0,5"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProxyStateText}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProxyStateText}" Value="RUNNING">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProxyStateText}" Value="STOPPED">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProxyStateText}" Value="FAULTED">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Key=Svc.Listening}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,5,0,5"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ListeningAddress}" Foreground="{StaticResource TextBrush}" Margin="0,5,0,5"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Key=Svc.Uptime}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,5,0,5"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Uptime}" Foreground="{StaticResource TextBrush}" Margin="0,5,0,5"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc Key=Svc.TotalRequests}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,5,0,5"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TotalRequests}" Foreground="{StaticResource TextBrush}" Margin="0,5,0,5"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Loc Key=Svc.TotalErrors}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,5,0,5"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TotalErrors}" Foreground="{StaticResource ErrorBrush}" Margin="0,5,0,5"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Loc Key=Svc.ActiveConnections}" Foreground="{StaticResource TextBrush}" Opacity="0.7" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ActiveConnections}" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"/>
            </Grid>
        </Border>

        <!-- Status Message -->
        <TextBlock Text="{Binding StatusMessage}"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Control Buttons -->
        <StackPanel Orientation="Horizontal">
            <Button Content="{loc:Loc Key=Svc.StartService}"
                    Command="{Binding StartServiceCommand}"
                    IsEnabled="{Binding CanStart}"
                    Background="#1E5E2E"
                    Foreground="White"
                    Padding="20,10"
                    Margin="0,0,12,0" />
            <Button Content="{loc:Loc Key=Svc.StopService}"
                    Command="{Binding StopServiceCommand}"
                    IsEnabled="{Binding CanStop}"
                    Background="#5A2020"
                    Foreground="White"
                    Padding="20,10"
                    Margin="0,0,12,0" />
            <Button Content="{loc:Loc Key=Svc.RestartService}"
                    Command="{Binding RestartServiceCommand}"
                    IsEnabled="{Binding CanRestart}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    Padding="20,10"
                    Margin="0,0,12,0" />
            <Button Content="{loc:Loc Key=Action.Refresh}"
                    Command="{Binding RefreshCommand}"
                    Padding="20,10" />
        </StackPanel>

        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="{loc:Loc Key=Svc.AutoRestart}"
                          IsChecked="{Binding AutoRestartOnFailure}"
                          Foreground="{StaticResource TextBrush}"
                          VerticalAlignment="Center" />
                <Button Content="{loc:Loc Key=Svc.ApplyRecovery}"
                        Command="{Binding UpdateAutoRestartCommand}"
                        Margin="16,0,0,0"
                        Padding="12,6" />
            </StackPanel>
        </Border>

        <!-- Info -->
        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Background="#1A1A2E">
            <TextBlock Foreground="{StaticResource TextBrush}" Opacity="0.7" FontSize="12" TextWrapping="Wrap">
                <Run FontWeight="SemiBold">Note:</Run>
                <Run> These controls report and manage the actual Windows Service. The proxy engine continues running when this administration window is closed.</Run>
            </TextBlock>
        </Border>
    </StackPanel>
</UserControl>
