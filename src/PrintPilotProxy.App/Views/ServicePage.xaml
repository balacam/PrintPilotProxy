<UserControl x:Class="PrintPilotProxy.App.Views.ServicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PrintPilotProxy.App;component/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="OPERATIONS" Style="{StaticResource PageEyebrowTextBlockStyle}" />
            <TextBlock Text="{loc:Loc Key=Page.Service}" Style="{StaticResource HeaderTextBlockStyle}" Margin="0" />
        </StackPanel>

        <!-- Live status overview -->
        <Border Style="{StaticResource HeroCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="1.9*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" Margin="0,0,13,0" Background="{StaticResource AccentSoftBrush}" CornerRadius="12">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=Svc.Header}" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0" />
                            <TextBlock Text="{loc:Loc Key=Svc.ServiceStatus}" Style="{StaticResource MetricLabelTextBlockStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding WindowsServiceState}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding StartupType, StringFormat={}{0}}" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />

                    <Border Margin="0,18,0,0" Padding="12,9" Background="#66101B30" BorderBrush="#34486A" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Svc.ProxyState}" Style="{StaticResource MetricLabelTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProxyStateText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProxyStateText}" Value="RUNNING">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProxyStateText}" Value="STOPPED">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProxyStateText}" Value="FAULTED">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Margin="22,0" Background="#34486A" HorizontalAlignment="Center" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Svc.Listening}" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <TextBlock Text="{Binding ListeningAddress}" Margin="0,5,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Svc.Uptime}" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <TextBlock Text="{Binding Uptime}" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Svc.TotalRequests}" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <TextBlock Text="{Binding TotalRequests}" Margin="0,5,0,0" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Svc.TotalErrors}" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <TextBlock Text="{Binding TotalErrors}" Margin="0,5,0,0" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource InsetPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Svc.ActiveConnections}" Style="{StaticResource MetricLabelTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ActiveConnections}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Result message -->
        <Border Margin="0,0,0,16" Padding="13,10" BorderThickness="1" CornerRadius="8" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="#2B6E5D" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErrorSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="#6F3043" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Controls -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" Margin="0,0,11,0" Background="{StaticResource AccentSoftBrush}" CornerRadius="9">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=Svc.WindowsServiceControl}" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0" />
                            <TextBlock Text="{loc:Loc Key=Svc.RequiresAdmin}" Style="{StaticResource MutedTextBlockStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,0,0,17">
                        <Button Content="{loc:Loc Key=Svc.StartService}" Command="{Binding StartServiceCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,9,9" />
                        <Button Content="{loc:Loc Key=Svc.StopService}" Command="{Binding StopServiceCommand}" IsEnabled="{Binding CanStop}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,9,9" />
                        <Button Content="{loc:Loc Key=Svc.RestartService}" Command="{Binding RestartServiceCommand}" IsEnabled="{Binding CanRestart}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,9,9" />
                    </WrapPanel>
                    <Border Style="{StaticResource InsetPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="{loc:Loc Key=Svc.AutoRestart}" IsChecked="{Binding AutoRestartOnFailure}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{loc:Loc Key=Svc.ApplyRecovery}" Command="{Binding UpdateAutoRestartCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" Margin="0,0,11,0" Background="{StaticResource InfoSurfaceBrush}" CornerRadius="9">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Key=Svc.ProxyEngineControl}" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{loc:Loc Key=Action.Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>
                    <WrapPanel>
                        <Button Content="{loc:Loc Key=Svc.StartEngine}" Command="{Binding StartProxyEngineCommand}" IsEnabled="{Binding CanStartProxyEngine}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,9,9" />
                        <Button Content="{loc:Loc Key=Svc.StopEngine}" Command="{Binding StopProxyEngineCommand}" IsEnabled="{Binding CanStopProxyEngine}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,9,9" />
                        <Button Content="{loc:Loc Key=Svc.RestartEngine}" Command="{Binding RestartProxyEngineCommand}" IsEnabled="{Binding CanRestartProxyEngine}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,9,9" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource InfoCardStyle}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource InfoBrush}" Margin="0,1,12,0" />
                <TextBlock Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}">
                    <Run FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{loc:Loc Key=Svc.NoteLabel}" />
                    <Run> </Run>
                    <Run Text="{loc:Loc Key=Svc.NoteText}" />
                </TextBlock>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
