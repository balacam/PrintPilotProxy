<UserControl x:Class="PrintPilotProxy.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PrintPilotProxy.App.Localization">
    <StackPanel>
        <!-- Page header -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="APPLICATION" Style="{StaticResource PageEyebrowTextBlockStyle}" />
            <TextBlock Text="{loc:Loc Key=Page.About}" Style="{StaticResource HeaderTextBlockStyle}" Margin="0" />
        </StackPanel>

        <!-- Hero Card -->
        <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="64"
                        Height="64"
                        Margin="0,0,20,0"
                        Background="{StaticResource AccentGradientBrush}"
                        CornerRadius="16"
                        VerticalAlignment="Top">
                    <Grid>
                        <Ellipse Width="40" Height="40" Fill="#20FFFFFF" />
                        <TextBlock Text="&#xE749;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="{Binding AppName}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <Border Margin="12,0,0,0"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentHoverBrush}" />
                        </Border>
                        <Border Margin="8,0,0,0"
                                Style="{StaticResource SuccessBadgeStyle}"
                                VerticalAlignment="Center">
                            <TextBlock Text="PRODUCTION READY"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{loc:Loc Key=About.Subtitle}"
                               Style="{StaticResource SubheaderTextBlockStyle}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="{loc:Loc Key=About.Description}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               LineHeight="20"
                               Margin="0,0,0,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status / Action feedback message -->
        <Border Margin="0,0,0,16"
                Padding="14,10"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="#2B6E5D" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErrorSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="#6F3043" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE73E;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Details and Management Grid -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- System Information Card -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=About.SystemInfo}" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0,0,0,14" />

                    <!-- Version info row -->
                    <Border Style="{StaticResource InsetPanelStyle}" Margin="0,0,0,10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=About.Version}" Foreground="{StaticResource MutedTextBrush}" FontWeight="Medium" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MonospaceTextBlockStyle}" Foreground="{StaticResource TextBrush}">
                                <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" (" Foreground="{StaticResource MutedTextBrush}" />
                                <Run Text="{Binding InformationalVersion, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                                <Run Text=")" Foreground="{StaticResource MutedTextBrush}" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Runtime row -->
                    <Border Style="{StaticResource InsetPanelStyle}" Margin="0,0,0,10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=About.Runtime}" Foreground="{StaticResource MutedTextBrush}" FontWeight="Medium" />
                            <TextBlock Grid.Column="1" Text="{Binding FrameworkDescription}" Style="{StaticResource MonospaceTextBlockStyle}" Foreground="{StaticResource TextBrush}" />
                        </Grid>
                    </Border>

                    <!-- OS row -->
                    <Border Style="{StaticResource InsetPanelStyle}" Margin="0,0,0,10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=About.Platform}" Foreground="{StaticResource MutedTextBrush}" FontWeight="Medium" />
                            <TextBlock Grid.Column="1" Text="{Binding OsDescription}" Style="{StaticResource MonospaceTextBlockStyle}" Foreground="{StaticResource TextBrush}" />
                        </Grid>
                    </Border>

                    <!-- Architecture row -->
                    <Border Style="{StaticResource InsetPanelStyle}" Margin="0,0,0,10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=About.Architecture}" Foreground="{StaticResource MutedTextBrush}" FontWeight="Medium" />
                            <TextBlock Grid.Column="1" Text="{Binding Architecture}" Style="{StaticResource MonospaceTextBlockStyle}" Foreground="{StaticResource TextBrush}" />
                        </Grid>
                    </Border>

                    <!-- Installation Directory row -->
                    <Border Style="{StaticResource InsetPanelStyle}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=About.InstallLocation}" Foreground="{StaticResource MutedTextBrush}" FontWeight="Medium" />
                            <TextBlock Grid.Column="1" Text="{Binding InstallPath}" Style="{StaticResource MonospaceTextBlockStyle}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallPath}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Fast Actions & Tools Card -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=About.Links}" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0,0,0,14" />

                    <Button Command="{Binding CopySystemInfoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,10"
                            Padding="14,10">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Key=About.CopySysInfo}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{loc:Loc Key=About.CopySysInfoDesc}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Command="{Binding OpenLogsDirectoryCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,10"
                            Padding="14,10">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xED43;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource InfoBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Key=About.OpenLogs}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{loc:Loc Key=About.OpenLogsDesc}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Command="{Binding OpenConfigDirectoryCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="14,10">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Key=About.OpenConfig}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{loc:Loc Key=About.OpenConfigDesc}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Core Capabilities Card -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=About.KeyFeatures}" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0,0,0,14" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Feature 1 -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InsetPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Margin="0,0,12,0" Background="{StaticResource AccentSoftBrush}" CornerRadius="9">
                                <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Loc Key=About.Feature1.Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{loc:Loc Key=About.Feature1.Desc}" Style="{StaticResource HelperTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Feature 2 -->
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource InsetPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Margin="0,0,12,0" Background="#362243" CornerRadius="9">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF85A1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Loc Key=About.Feature2.Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{loc:Loc Key=About.Feature2.Desc}" Style="{StaticResource HelperTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Feature 3 -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InsetPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Margin="0,0,12,0" Background="#1D383A" CornerRadius="9">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Loc Key=About.Feature3.Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{loc:Loc Key=About.Feature3.Desc}" Style="{StaticResource HelperTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Feature 4 -->
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource InsetPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Margin="0,0,12,0" Background="#1B324D" CornerRadius="9">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Loc Key=About.Feature4.Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{loc:Loc Key=About.Feature4.Desc}" Style="{StaticResource HelperTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Copyright & License Footer -->
        <Border Padding="14,12" Background="#400E1728" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=About.Copyright}"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding Version, StringFormat='PrintPilotProxy v{0}'}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
